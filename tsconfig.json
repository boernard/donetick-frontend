// https://www.typescriptlang.org/tsconfig/
// Bundler-mode config for the Vite app. Vite/SWC does the emitting; tsc only
// type-checks. checkJs and strict stay off until files are converted layer by
// layer (see docs/ai/status-and-roadmap.md).
{
  "compilerOptions": {
    // Language and Environment
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],

    // Modules
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": { "@/*": ["./src/*"] },

    // JavaScript
    "allowJs": true,
    "checkJs": false,

    // Emit
    "noEmit": true,

    // Type Checking
    "strict": false,
    "skipLibCheck": true
  },
  "include": ["src"]
}
